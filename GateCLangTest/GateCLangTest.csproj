<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <StartupObject>Gate.CLanguageTest.TxtStoreTest</StartupObject>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MouseKeyHook" Version="5.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GateLangBaseSupport\GateLangBaseSupport.vcxproj" />
    <ProjectReference Include="..\GateLangBase\GateLangBase.csproj" />
    <ProjectReference Include="..\GateToolsView\GateToolsView.csproj" />
    <ProjectReference Include="..\GateTools\GateTools.csproj" />
     <ProjectReference Include="..\ScintillaNet\ScintillaNet.csproj" />
     <ProjectReference Include="..\SeaMathWindows\SeaMathWindows.csproj" />
     <ProjectReference Include="..\SeaMath\SeaMath.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

   <PropertyGroup>
      <NoWarn>$(NoWarn);NU1701;NU1901;NU1902</NoWarn>
   </PropertyGroup>

</Project>